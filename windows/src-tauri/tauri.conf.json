{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesktopPet",
  "version": "0.1.5",
  "identifier": "online.thenightwatcher.desktoppet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "stage",
        "title": "DesktopPet",
        "url": "stage.html",
        "width": 1920,
        "height": 1080,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false,
        "x": 0,
        "y": 0
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://pets.thenightwatcher.online data: ; connect-src 'self' https://pets.thenightwatcher.online https://github.com ipc: http://ipc.localhost ; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Utility",
    "license": "MIT",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Imzl-zl",
    "homepage": "https://github.com/Imzl-zl/desktop-pet",
    "shortDescription": "A desktop companion that keeps you company while you work.",
    "longDescription": "DesktopPet floats a pixel companion on your desktop. Optional coding-agent integrations (Claude Code, Codex, Gemini, Cursor, ...) let it react to your work in real time.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "SimpChinese",
          "Vietnamese"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGQjczRkJDRTBENUNEREUKUldUZXpkWGd2RCszUC80OHlGRGQ1THBuUnZ6VnpsQWN5elhvOFNzRDkvY0lNVTlWWHgyR29ML1gK",
      "endpoints": [
        "https://github.com/Imzl-zl/desktop-pet/releases/latest/download/latest.json"
      ]
    }
  }
}